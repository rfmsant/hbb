---
import { site } from '../data/site';
import { meetingSteps } from '../data/areas';
import { ph } from '../data/ph';
import { ui } from '../i18n/ui';
import { localePath, type Locale } from '../i18n/config';
interface Props { lang: Locale; area?: string }
const { lang, area } = Astro.props;
const t = ui[lang];
const href = localePath(lang, '/book/') + (area ? `?area=${area}` : '');
const pt = lang === 'pt';
---
<section class="section section--navy" id="book">
  <div class="wrap grid grid--2" style="align-items:start">
    <div class="stack">
      <p class="eyebrow">{pt ? 'Primeira reunião' : 'Initial meeting'}</p>
      <h2>{pt ? 'Marque uma primeira reunião com a advogada da área.' : 'Book an initial meeting with the lawyer for the area.'}</h2>
      <div class="btn-row"><a class="btn btn--primary" href={href} data-cta="book-block">{t.cta}</a></div>
      <p class="small" style="color:#D9D4C8" set:html={ph(`${pt ? 'Prefere ligar?' : 'Prefer to call?'} ${site.phone} · ${site.email}`)} />
    </div>
    <ol class="steps steps--navy">
      {meetingSteps[lang].map(([title, text]) => <li><h3>{title}</h3><p>{text}</p></li>)}
    </ol>
  </div>
</section>
