---
---
<div class="consent" id="consent" role="dialog" aria-live="polite" aria-label="Cookie choices" hidden>
  <p>We use analytics cookies to understand which pages help people and where the booking form can be simpler. Nothing is shared for advertising without your consent.</p>
  <div class="btn-row">
    <button class="btn btn--primary" data-consent="all" type="button">Accept analytics</button>
    <button class="btn btn--ghost" data-consent="none" type="button">Only necessary</button>
  </div>
  <a href="/cookies/" class="small">Cookie policy</a>
</div>
<style>
  .consent { position: fixed; z-index: 40; left: 12px; right: 12px; bottom: calc(12px + env(safe-area-inset-bottom, 0px)); max-width: 560px; margin-left: auto; background: var(--white); border: 1px solid var(--navy); padding: 20px; display: flex; flex-direction: column; gap: 14px; font-size: 15px; box-shadow: 0 10px 30px rgba(18,35,63,.18); }
  .consent[hidden] { display: none; }
</style>
<script>
  import { applyConsent, getConsent } from '../scripts/analytics';
  const box = document.getElementById('consent')!;
  if (!getConsent()) box.hidden = false;
  box.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((b) =>
    b.addEventListener('click', () => { applyConsent(b.dataset.consent === 'all'); box.hidden = true; }));
  document.querySelectorAll('[data-open-consent]').forEach((b) => b.addEventListener('click', () => { box.hidden = false; }));
</script>
