---
import Logo from './Logo.astro';
import { ui } from '../i18n/ui';
import { localePath, type Locale } from '../i18n/config';
interface Props { lang: Locale; alt: string }
const { lang, alt } = Astro.props;
const t = ui[lang];
const h = (p: string) => localePath(lang, p);
const book = h('/book/');
---
<header class="hdr">
  <div class="wrap hdr__in">
    <Logo href={h('/')} label={lang === 'pt' ? 'HBB Harbor Beyond Borders, início' : 'HBB Harbor Beyond Borders, home'} />
    <nav class="hdr__nav" aria-label={lang === 'pt' ? 'Principal' : 'Main'}>
      {t.nav.map(([p, l]) => <a href={h(p)}>{l}</a>)}
    </nav>
    <div class="hdr__end">
      <a href={alt} class="hdr__lang" hreflang={lang === 'pt' ? 'en' : 'pt-PT'} lang={lang === 'pt' ? 'en' : 'pt-PT'}>{lang === 'pt' ? 'EN' : 'PT'}</a>
      <a href={book} class="btn btn--primary hdr__cta" data-cta="header">{t.cta}</a>
      <button class="hdr__menu" aria-expanded="false" aria-controls="mnav" type="button">{t.menu}</button>
    </div>
  </div>
  <nav id="mnav" class="mnav" aria-label="Mobile" hidden>
    {t.nav.map(([p, l]) => <a href={h(p)}>{l}</a>)}
    <a href={alt} lang={lang === 'pt' ? 'en' : 'pt-PT'}>{t.langSwitch}</a>
    <a href={book} class="btn btn--primary" data-cta="mobile-menu">{t.cta}</a>
  </nav>
</header>
<a href={book} class="sticky-cta btn btn--primary" data-cta="sticky">{t.cta}</a>
<style>
  .hdr { position: sticky; top: 0; z-index: 20; background: var(--white); border-bottom: 1px solid var(--line); }
  .hdr__in { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 76px; }
  .hdr__nav { display: flex; gap: 26px; font-size: 15px; }
  .hdr__nav a { text-decoration: none; }
  .hdr__end { display: flex; align-items: center; gap: 16px; }
  .hdr__lang { font-size: 14px; font-weight: 500; letter-spacing: .1em; text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; padding: 0 4px; }
  .hdr__menu { display: none; min-height: 44px; padding: 0 16px; background: none; border: 1px solid var(--navy); font: 500 15px var(--sans); color: var(--navy); }
  .mnav { display: flex; flex-direction: column; gap: 4px; padding: 12px 20px 20px; border-top: 1px solid var(--line); background: var(--white); }
  .mnav[hidden] { display: none; }
  .mnav a:not(.btn) { padding: 12px 0; text-decoration: none; font-size: 18px; border-bottom: 1px solid var(--line); }
  .mnav .btn { margin-top: 12px; }
  .sticky-cta { display: none; }
  @media (max-width: 1120px) {
    .hdr__nav, .hdr__cta { display: none; }
    .hdr__menu { display: inline-flex; align-items: center; }
    .sticky-cta { display: flex; position: fixed; left: 12px; right: 12px; bottom: calc(12px + env(safe-area-inset-bottom, 0px)); z-index: 30; box-shadow: 0 6px 20px rgba(18,35,63,.25); }
  }
</style>
<script>
  const b = document.querySelector('.hdr__menu') as HTMLButtonElement;
  const m = document.getElementById('mnav')!;
  b?.addEventListener('click', () => { const o = m.hidden; m.hidden = !o; b.setAttribute('aria-expanded', String(o)); });
  // No sticky button on the booking page itself.
  if (/\/(book|marcar)\/?$/.test(location.pathname)) document.querySelector('.sticky-cta')?.remove();
</script>
