---
// Temporary text logo while the final logo is chosen. Swap this one file when it is.
interface Props { href: string; label: string; negative?: boolean }
const { href, label, negative = false } = Astro.props;
---
<a href={href} class:list={['logo', { 'logo--neg': negative }]} aria-label={label}>
  <span class="logo__hbb">HBB</span>
  <span class="logo__rule" aria-hidden="true"></span>
  <span class="logo__name">Harbor<br>Beyond Borders</span>
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: 14px; text-decoration: none; color: var(--navy); }
  .logo__hbb { font-family: var(--serif); font-size: 26px; letter-spacing: .16em; line-height: 1; padding-left: .16em; }
  .logo__rule { width: 1px; height: 30px; background: currentColor; opacity: .5; }
  .logo__name { font-family: var(--sans); font-size: 11px; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; line-height: 1.35; }
  .logo--neg { color: var(--ivory); }
  .logo:hover { color: inherit; }
  .logo--neg:hover { color: var(--ivory); }
</style>
