---
import '@fontsource/libre-caslon-text/400.css';
import '@fontsource/libre-caslon-text/700.css';
import '@fontsource/jost/400.css';
import '@fontsource/jost/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Consent from '../components/Consent.astro';
import { SAMPLE } from '../data/ph';
interface Props { title: string; description: string; noindex?: boolean }
const { title, description } = Astro.props;
const noindex = Astro.props.noindex || import.meta.env.PUBLIC_NOINDEX === '1';
const full = title.includes('HBB') ? title : `${title} · HBB Harbor Beyond Borders`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{full}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex">}
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}>
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon-180.png">
  <meta property="og:title" content={full}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta name="theme-color" content="#12233F">
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'LegalService', name: 'HBB — Harbor Beyond Borders', areaServed: 'PT', address: { '@type': 'PostalAddress', addressLocality: 'Lisbon', addressCountry: 'PT' } })} />
</head>
<body>
  <a href="#main" class="skip">Skip to content</a>
  {SAMPLE && <div class="preview-bar">Preview · sample photos and figures, not final</div>}
  <Header />
  <main id="main"><slot /></main>
  <Footer />
  <Consent />
  <style is:global>
    .preview-bar { background: var(--navy); color: var(--gold-light); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; text-align: center; padding: 6px 16px; }
    .skip { position: absolute; left: -9999px; } .skip:focus { left: 12px; top: 12px; z-index: 50; background: var(--white); padding: 8px 12px; }
  </style>
  <script>
    import { track } from '../scripts/analytics';
    document.querySelectorAll<HTMLElement>('[data-cta]').forEach((a) => a.addEventListener('click', () => track('cta_click', { location: a.dataset.cta })));
  </script>
</body>
</html>
