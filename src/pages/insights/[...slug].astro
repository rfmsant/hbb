---
import Base from '../../layouts/Base.astro';
import BookBlock from '../../components/BookBlock.astro';
import { getCollection } from 'astro:content';
import { breadcrumbs } from '../../lib/schema';
import { locales } from '../../i18n/config';
export async function getStaticPaths() {
  const posts = await getCollection('insights', (p) => !p.data.draft);
  return posts.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await p.render();
const lang = p.data.lang;
const pt = lang === 'pt';
const base = new URL(import.meta.env.BASE_URL.replace(/\/?$/, '/'), Astro.site);
const checked = p.data.updated ?? p.data.date;
const fmt = (d: Date) => d.toLocaleDateString(locales[lang].date, { day: 'numeric', month: 'long', year: 'numeric' });
const schema = [
  { '@type': 'Article', headline: p.data.title, description: p.data.description, datePublished: p.data.date.toISOString(), dateModified: checked.toISOString(), inLanguage: locales[lang].html, author: { '@id': new URL('#firm', base).href }, publisher: { '@id': new URL('#firm', base).href }, mainEntityOfPage: new URL(`insights/${p.slug}/`, base).href, articleSection: p.data.category },
  breadcrumbs(base, [[pt ? 'Início' : 'Home', '/'], [pt ? 'Artigos' : 'Insights', '/insights/'], [p.data.title, `/insights/${p.slug}/`]]),
];
---
<Base lang={lang} path={`/insights/${p.slug}/`} title={p.data.title} description={p.data.description} schema={schema}>
  <article class="section">
    <div class="wrap stack" style="gap:24px">
      <p class="crumbs"><a href={pt ? '/pt/artigos/' : '/insights/'}>{pt ? 'Artigos' : 'Insights'}</a> / {p.data.category}</p>
      <h1 style="max-width:22ch">{p.data.title}</h1>
      <p class="small muted">{p.data.author} · {pt ? 'Publicado a' : 'Published'} {fmt(p.data.date)} · <b>{pt ? 'Última revisão' : 'Last checked'} {fmt(checked)}</b></p>
      <hr class="rule">
      <div class="prose"><Content /></div>
      <p class="small muted" style="max-width:70ch">{pt ? 'Este artigo é informação geral e não substitui aconselhamento jurídico para o seu caso. As regras mudam; confirme a data acima.' : 'This article is general information, not legal advice for your situation. Rules change; check the date above.'}</p>
    </div>
  </article>
  <BookBlock lang={lang} />
</Base>
