---
import Base from '../../layouts/Base.astro';
import BookBlock from '../../components/BookBlock.astro';
import { areas, services } from '../../data/services';
---
<Base title="Services" description="Residency, citizenship, tax, property, companies and succession for people moving to Portugal.">
  <section class="section">
    <div class="wrap stack" style="gap:48px">
      <div class="stack"><p class="eyebrow">Services</p><h1>One plan across five areas of law.</h1><p class="lead">Residency, tax, property and succession affect each other. We decide them together, with one lawyer leading your case.</p></div>
      {areas.map((a) => {
        const list = services.filter((s) => s.area === a.slug);
        return list.length > 0 && (
          <div class="stack" style="gap:16px">
            <h2 style="font-size:28px">{a.title}</h2>
            <div class="grid">{list.map((s) => <a class="card" href={`/services/${s.slug}/`} style="text-decoration:none"><h3>{s.title}</h3><p class="muted">{s.short}</p><span class="more">Read more →</span></a>)}</div>
          </div>
        );
      })}
    </div>
  </section>
  <BookBlock />
</Base>
